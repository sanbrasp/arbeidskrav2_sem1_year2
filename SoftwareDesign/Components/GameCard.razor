<div class="game-card">
    <h2>@Name</h2>
    <h5 class="minplayers">Min players: @MinPlayers</h5>
    <h5 class="maxplayers">Max players: @MaxPlayers</h5>
    <h5 class="category">Category: @Category</h5>
    <h5 class="description">Description: @Description</h5>
    <h5 class="rating">Rating: @Rating</h5>
</div>

@code {
    // TODO: Add parameter for ID when finished
    [Parameter] public string Name { get; set; }
    [Parameter] public int MinPlayers { get; set; }
    [Parameter] public int MaxPlayers { get; set; }
    [Parameter] public string Category { get; set; }
    [Parameter] public string Description { get; set; }
    [Parameter] public int Rating { get; set; }
    [Parameter] public EventCallback<string> OnPick { get; set; }

    private async Task OnPickClicked()
    {
        await OnPick.InvokeAsync(Name);
    }
}