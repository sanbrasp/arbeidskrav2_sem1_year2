<div class="game-card @(IsPickedCard ? "picked-card" : "")">
    <p class="name">@Name</p>
    <p class="minplayers">Min players: @MinPlayers</p>
    <p class="maxplayers">Max players: @MaxPlayers</p>
    <p class="category">Category: @Category</p>
    <p class="description">Description: @Description</p>
    <p class="rating">Rating: @Rating</p>
    <button class="play-button">Play</button>
</div>

@code {
    // TODO: Add parameter for ID when finished
    [Parameter] public string Name { get; set; }
    [Parameter] public int MinPlayers { get; set; }
    [Parameter] public int MaxPlayers { get; set; }
    [Parameter] public string Category { get; set; }
    [Parameter] public string Description { get; set; }
    [Parameter] public int Rating { get; set; }
    [Parameter] public EventCallback<string> OnPick { get; set; }
    [Parameter] public bool IsPickedCard { get; set; }

    private async Task OnPickClicked()
    {
        await OnPick.InvokeAsync(Name);
    }
}