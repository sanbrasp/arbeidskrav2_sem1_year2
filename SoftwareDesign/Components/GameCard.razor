<div class="game-card @(IsPickedCard ? "picked-card" : "") @(IsInGameNight ? "game-night" : "")">
    <p class="name">@Name</p>
    <p class="minplayers">Min players: @MinPlayers</p>
    <p class="maxplayers">Max players: @MaxPlayers</p>
    <p class="category">Category: @Category</p>
    <p class="description">Description: @Description</p>
    <DiceRating Value="Rating" ReadOnly="true" />
    <p class="id">Id: @Id</p>
    
    @if (IsInGameNight)
    {
        <button class="remove-from-game-night-button" @onclick="RemoveFromGameNight">Remove the game from game night
        </button>
    }
    else
    {
        <button class="add-to-game-night-button" @onclick="AddToGameNight">Add to game night
        </button>
    }
    
    <a class="game-link" href="/games/@Id">Link to game's page.</a>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int MinPlayers { get; set; }
    [Parameter] public int MaxPlayers { get; set; }
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public int Rating { get; set; }
    [Parameter] public bool IsPickedCard { get; set; }
    [Parameter] public bool IsInGameNight { get; set; }
    [Parameter] public EventCallback<int> OnAddToGameNight { get; set; }
    [Parameter] public EventCallback<int> OnRemoveFromGameNight { get; set; }
    
    private async Task AddToGameNight()
    {
        await OnAddToGameNight.InvokeAsync(Id);
    }

    private async Task RemoveFromGameNight()
    {
        await OnRemoveFromGameNight.InvokeAsync(Id);
    }
}