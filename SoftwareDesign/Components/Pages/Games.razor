@page "/games"
@rendermode InteractiveServer
@using SoftwareDesign.Data
@using SoftwareDesign.Models
@using SoftwareDesign.Services
@inject GameRepository GameRepo
@inject GameFilterService FilterService
@inject GameRandomizer Randomizer
@inject GameNightState State

<h1>Games</h1>


<div class="search-field">
    <input @bind="_searchInput" @bind:event="oninput" placeholder="Search for a game" />
    <label for="dropdown-menu" class="dropdown-label">Number of players:</label>
    
    <select @bind="_numberOfPlayers" id="dropdown-menu">
        <option value="0">Any</option>
        @for (int amount = 1; amount <= FilterService.MaxAmountOfPlayers(_boardGames); amount++)
        {
            <option value="@amount">@amount</option>
        }
    </select>
    
    <button @onclick="RandomizeGame">🎲Roll the Die</button>
    
    <p>Hits: @(SearchResultWithNumberOfPlayers.Count())</p>
    
    @if (!SearchResultWithNumberOfPlayers.Any())
    {
        <p>No games matching the search.</p>
    }
</div>

@if (!string.IsNullOrEmpty(_confirmation))
{
    <p class="confirmation">@_confirmation</p>
}

@if (_boardGames.Count == 0)
{
    <p>No games found...</p>
}
else
{
    <div class="game-grid">
        @foreach (var game in SearchResultWithNumberOfPlayers)
        {
            <GameCard Name="@game.Name" MinPlayers="@game.MinPlayers" MaxPlayers="@game.MaxPlayers"
            Category="@game.Category" Description="@game.Description" Rating="@game.Rating" 
            IsPickedCard="@(game == _randomBoardGame)" IsInGameNight="@(State.IsGameInGameNightList(game.Id))" 
            Id="@game.Id" OnAddToGameNight="HandleAddToGameNight" OnRemoveFromGameNight="HandleRemoveFromGameNight"/>
        }
    </div>
}

@code {
    
    IReadOnlyList<BoardGame> _boardGames = new List<BoardGame>();
    
    private BoardGame? _randomBoardGame = null;
    private string _searchInput = "";
    private int _numberOfPlayers = 0;
    private string _confirmation = "";
    
    private IReadOnlyList<BoardGame> SearchResultWithNumberOfPlayers => 
        _numberOfPlayers == 0 ? SearchResult : FilterService.FilterByNumberOfPlayers(SearchResult, _numberOfPlayers);
    private IReadOnlyList<BoardGame> SearchResult => FilterService.Filter(_boardGames, _searchInput);
    
    protected override void OnInitialized()
    {
        _boardGames = GameRepo.GetAllGames();
    }

    private void RandomizeGame()
    {
        _randomBoardGame = Randomizer.GetRandomGame(SearchResultWithNumberOfPlayers);
    }

    private void HandleAddToGameNight(int id)
    {
        var game = GameRepo.GetGameById(id);
        
        if (game != null)
        {
            State.AddToGameNight(game);
            _confirmation = $"{game.Name} has been added to game night";
        }
    }

    private void HandleRemoveFromGameNight(int id)
    {
        var game = GameRepo.GetGameById(id);

        if (game != null)
        {
            State.RemoveFromGameNight(game);
            _confirmation = $"{game.Name} has been removed from game night";
        }
    }
}
