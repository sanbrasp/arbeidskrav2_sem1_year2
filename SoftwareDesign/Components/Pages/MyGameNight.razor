@page "/my-game-night"
@rendermode InteractiveServer
@using SoftwareDesign.Data
@using SoftwareDesign.Models
@using SoftwareDesign.Services
@inject GameRepository GameRepo
@inject GameNightState State


<h3>MyGameNight</h3>

<div class="game-night-games">
    <p>Hits: @(_addedGames.Count)</p> // list from service here
    
    @if (!_addedGames.Any()) // list from service here
    {
        <p>You haven't added any games yet! Go look at some!</p>
        <a href="/games">Game library</a>
    }
</div>

<a href="/">Go back to home.</a>

@code {
    IReadOnlyList<BoardGame> _addedGames = new List<BoardGame>();

    protected override void OnInitialized()
    {
        _addedGames = State.GetGameNightGames();
    }

}